# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Dev run directory: world saves, logs, downloaded mods, player tracks
run/

# Logs and crash dumps
logs/
*.log
crash-reports/

# Manual backups from before git. Kept on disk, out of the history.
rollback/

# macOS
.DS_Store

# Editor settings: ModDevGradle writes absolute local paths into launch.json
.vscode/

# A check once ran with the literal "(Join-Path" as its folder and left DJ presets in it, which got committed
# (tools/run-check.py has understood that argument since). Such a stray folder never belongs in the repository.
/(Join-Path/
